";
  const MODEL_ORDER=['retained','frozen','audit','reset','oracle'];
  const SCENARIO_ORDER=['stable','clean','noisy','sparse','load','truth_reversal','misinformation','wrong_history','no_cost','neutral'];
  const MODEL_LABELS={retained:'Retained + adult updating',frozen:'Frozen adult conviction',audit:'Confidence-based adult audit',reset:'Reset at maturation · ablation',oracle:'Oracle confidence gate · privileged'};
  const SCENARIO_LABELS={stable:'Stable baseline',clean:'Cleaner private cues',noisy:'Noisy private cues',sparse:'Sparse private access',load:'Higher information load',truth_reversal:'True environmental reversal',misinformation:'Temporary signed-signal misinformation',wrong_history:'Wrong initial cultural history',no_cost:'Zero query cost',neutral:'No payoff + zero query cost'};
  const SCENARIO_EXPLAIN={stable:'Truth and signed cue process are stable.',clean:'Private cue correctness rises to p=0.85 for everyone in the context.',noisy:'Private cue correctness falls to p=0.55 for everyone in the context.',sparse:'Private opportunities are thinned by access=0.2.',load:'The load multiplier D=5 divides private and social exposure rates; it is not a simulated repertoire.',truth_reversal:'Truth flips at t=150 and the actual signed-cue distribution changes with it.',misinformation:'Truth stays +1; actual signed + cues fall to 0.15 from t=150 to 210, then recover.',wrong_history:'Initial adult conviction is mostly wrong; evidence rules are unchanged.',no_cost:'Query-linked mortality cost is set to zero; evidence access is unchanged.',neutral:'Correctness has no demographic payoff and query cost is zero.'};
  const METRICS={
    N:['Final population N','Final continuous population density.'],rT:['Finite-horizon population growth rT','Log N(T)/N(0) per model-time unit over the stored horizon; not invasion.'],delta_rT:['Matched deference delta rT','Selected rT minus d=0 rT at the same architecture, scenario, and tau.'],invasion:['Rare-mutant invasion exponent','Growth in the declared common retained resident culture/resource environment; unavailable for time-changing scenarios.'],survival:['Survival to maturity · final information held fixed','Conditional newborn maturation probability if final evidence and advice are frozen; not realized changing-environment cohort survival.'],private_F:['Final juvenile private accuracy','Correct sign of private ledger u among juveniles.'],private_A:['Final adult private accuracy','Correct sign of private ledger u among adults.'],belief_F:['Final juvenile held-conviction accuracy','Correct sign of held score b among juveniles.'],belief_A:['Final adult held-conviction accuracy','Correct sign of held score b among adults.'],public_F:['Final juvenile public-action accuracy','Accuracy of expressed juvenile action.'],advice:['Final teacher/advice accuracy','Accuracy of transmitted adult sign after transmission error.'],confidence:['Final mean adult |b|','Mean bounded conviction depth among adults.'],persistence:['Final high-depth adult fraction','Adult fraction with |b|>2; a score-depth measure, not a diagnosis.'],wrong_confidence:['Final wrong high-depth adult fraction','Adult fraction with wrong sign and |b|>2.'],peak_wrong_confidence:['Peak wrong high-depth adult fraction','Maximum wrong high-depth fraction during the stored trajectory.'],query_rate:['Final query rate per capita','Private query events divided by total N at the final time.'],query_A:['Final adult query rate','Adult private-query events divided by adult density.'],query_cost:['Final aggregate query-cost flow','Excess mortality flow c_query × total private queries; not a per-capita rate.'],cumulative_query_cost:['Cumulative query-cost flow','Time integral of aggregate excess mortality flow over the stored run.'],override:['Final override | conflict','P(adult action chosen | private sign conflicts with testimony); null when no conflicts occur.'],conflict:['Final conflict exposure','P(private sign conflicts with testimony) among juveniles.'],tail_growth:['Last-100-time-unit log growth','Finite tail-window population growth rate; not asymptotic.'],recovery:['Half-recovery after intervention','First sustained 20-time-unit return halfway from chance to the model-matched stable endpoint; only defined for reversal/misinformation.'],accuracy_debt:['Adult accuracy debt','Post-intervention time-integrated adult held-accuracy deficit relative to the matched stable trajectory.']
  };
  const COLORS={F:'#49c7d5',A:'#f0ad63',N:'#edf5f8',private_F:'#87a7ff',private_A:'#c4a0ef',belief_F:'#49c7d5',belief_A:'#70d1a0',public_F:'#49c7d5',advice:'#f0ad63',conflict:'#f17878',override:'#ffd166',query_F:'#49c7d5',query_A:'#c4a0ef',query_rate:'#70d1a0',query_cost:'#f17878'};
  const $=id=>document.getElementById(id),finite=x=>x!==null&&x!==undefined&&x!==''&&Number.isFinite(Number(x));
  const fmt=(x,d=4)=>finite(x)?(Math.abs(Number(x))>=100?Number(x).toFixed(1):Math.abs(Number(x))>=1?Number(x).toFixed(3):Number(x).toPrecision(d)):'not available';
  const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const nearest=(a,x)=>a.reduce((best,v,i)=>Math.abs(v-x)<Math.abs(a[best]-x)?i:best,0);
  const axisTitle=text=>({text});
  const plotConfig={responsive:true,displaylogo:false,toImageButtonOptions:{format:'png',filename:'v5-information-access',scale:2}};
  let DATA,ctx,di=0,ti=0,cursor=0,timer=null,pins=[];
  const state={ready:false};window.AppState=state;

  async function embeddedData(){if(!('DecompressionStream' in window))throw Error('This browser lacks DecompressionStream support.');const binary=atob(EMBEDDED_GZIP_BASE64),bytes=new Uint8Array(binary.length);for(let i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return JSON.parse(await new Response(stream).text())}
  const context=(model=$('model').value,scenario=$('scenario').value)=>DATA.contexts.find(x=>x.model===model&&x.scenario===scenario);
  const cellIndex=(d=di,t=ti,c=ctx)=>c?.oracle_compact?t:d*DATA.taus.length+t;
  const metricValue=(key,d=di,t=ti,c=ctx)=>c.metrics[key]?.[cellIndex(d,t,c)]??null;
  const series=(key,d=di,t=ti,c=ctx)=>c.series[key]?.[cellIndex(d,t,c)]||[];
  const selectedD=()=>ctx.d_inactive?0:di;
  const selectedRecord=()=>({run_id:DATA.run_id,label:DATA.label,context_id:ctx.id,model:ctx.model,scenario:ctx.scenario,d:ctx.d_inactive?null:DATA.ds[di],tau:DATA.taus[ti],d_inactive:ctx.d_inactive,config:ctx.config,segments:ctx.segments});
  const eventShapes=()=>[{type:'line',xref:'x',yref:'paper',x0:DATA.t[cursor],x1:DATA.t[cursor],y0:0,y1:1,line:{color:'#edf5f8',width:1,dash:'dot'}},...ctx.segments.slice(1).map(s=>({type:'line',xref:'x',yref:'paper',x0:s[0],x1:s[0],y0:0,y1:1,line:{color:'#f0ad63',width:2,dash:'dash'}}))];
  function layout(yTitle,extra={}){return {paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:76,r:20,t:28,b:58},xaxis:{title:axisTitle('Model time'),gridcolor:'#35526a'},yaxis:{title:axisTitle(yTitle),gridcolor:'#35526a',zerolinecolor:'#668aa0'},legend:{orientation:'h',y:1.17},shapes:eventShapes(),...extra}}
  function trace(key,name,d=di,t=ti,c=ctx,style={}){return {type:'scatter',mode:'lines',name,x:DATA.t,y:series(key,d,t,c),connectgaps:false,line:{color:COLORS[key],width:2,...style},hovertemplate:`t=%{x:.4g}<br>${escapeHtml(name)}=%{y:.6g}<extra></extra>`}}

  function populate(){for(const m of MODEL_ORDER.filter(m=>DATA.contexts.some(c=>c.model===m)))$('model').add(new Option(MODEL_LABELS[m],m));for(const s of SCENARIO_ORDER.filter(s=>DATA.contexts.some(c=>c.scenario===s)))$('scenario').add(new Option(SCENARIO_LABELS[s],s));for(const [k,[label]] of Object.entries(METRICS))$('metric').add(new Option(label,k));$('dSlider').max=DATA.ds.length-1;$('tauSlider').max=DATA.taus.length-1;$('scrub').max=DATA.t.length-1;$('model').value='retained';$('scenario').value='stable';$('metric').value='rT';di=nearest(DATA.ds,.5);ti=nearest(DATA.taus,3);$('dSlider').value=di;$('tauSlider').value=ti;ctx=context();pins=[{model:'retained',scenario:'stable',di:0,ti},{model:'retained',scenario:'stable',di,ti},{model:'frozen',scenario:'stable',di,ti}]}

  function refreshControls(){ctx=context();if(!ctx)throw Error('Selected context is absent');if(ctx.d_inactive){di=0;$('dSlider').value=0;$('dSlider').disabled=true;$('dOut').value='inactive';$('inactiveNote').hidden=false;$('inactiveNote').textContent='d is inactive for the oracle gate; duplicate d cells are displayed only to preserve the common grid.'}else{$('dSlider').disabled=false;$('dOut').value=fmt(DATA.ds[di]);$('inactiveNote').hidden=true}$('dSlider').value=di;$('tauSlider').value=ti;$('tauOut').value=fmt(DATA.taus[ti]);$('scrub').value=cursor;$('timeOut').value=fmt(DATA.t[cursor]);$('metricNote').textContent=METRICS[$('metric').value]?.[1]||'';$('configView').textContent=JSON.stringify({...selectedRecord(),resident:ctx.resident},null,2);$('selection').innerHTML=`<strong>${escapeHtml(MODEL_LABELS[ctx.model])}</strong><br>${escapeHtml(SCENARIO_LABELS[ctx.scenario])}<br>d=${ctx.d_inactive?'inactive':fmt(DATA.ds[di])}, tau=${fmt(DATA.taus[ti])}`;$('runId').textContent=DATA.run_id;Object.assign(state,{ctx:ctx.id,di,ti,cursor})}

  function heatmap(){const key=$('metric').value,z=DATA.taus.map((_,t)=>DATA.ds.map((_,d)=>metricValue(key,d,t)));const values=z.flat().filter(finite).map(Number),signed=['delta_rT','invasion','tail_growth'].includes(key),lim=signed&&values.length?Math.max(...values.map(Math.abs)):null;const color=signed?[[0,'#a9455d'],[.5,'#f1f2ee'],[1,'#277fa4']]:'Viridis';const hm={type:'heatmap',x:DATA.ds,y:DATA.taus,z,hoverongaps:false,colorscale:color,colorbar:{title:axisTitle(METRICS[key]?.[0]||key)},hovertemplate:`d=%{x:.4g}<br>tau=%{y:.4g}<br>${escapeHtml(METRICS[key]?.[0]||key)}=%{z:.7g}<extra></extra>`};if(lim){hm.zmin=-lim;hm.zmax=lim}Plotly.react('traitMap',[hm],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:88,r:38,t:24,b:68},xaxis:{title:axisTitle(ctx.d_inactive?'Deference d · inactive duplicate cells':'Deference d = P(override | disagreement)'),range:[0,1],gridcolor:'#35526a'},yaxis:{title:axisTitle('Mean maturation time tau · log scale'),type:'log',range:[Math.log10(Math.min(...DATA.taus)),Math.log10(Math.max(...DATA.taus))],tickmode:'array',tickvals:[.5,1,2,3,5,8,12],ticktext:['0.5','1','2','3','5','8','12'],gridcolor:'#35526a'}},plotConfig).then(()=>{const el=$('traitMap');if(el.removeAllListeners)el.removeAllListeners('plotly_click');el.on('plotly_click',event=>{const p=event.points?.[0];if(!p)return;di=ctx.d_inactive?0:nearest(DATA.ds,Number(p.x));ti=nearest(DATA.taus,Number(p.y));cursor=0;refreshAll()})});$('mapStatus').textContent=values.length?`${values.length} finite stored cells. Ability H=${ctx.config.H}, cue property p=${fmt(ctx.config.p)}, access=${fmt(ctx.config.access)}, load=${fmt(ctx.config.load)} are fixed across this map.`:'This metric is unavailable for every cell in the selected context; missing values were not replaced.'}

  function matched(){const baseD=0,metrics=['N','rT','tail_growth','survival','private_A','belief_A','public_F','advice','conflict','override','query_rate','query_A','query_cost','cumulative_query_cost','wrong_confidence'];const rows=metrics.map(k=>({key:k,label:METRICS[k][0],selected:metricValue(k,selectedD(),ti),baseline:metricValue(k,baseD,ti)}));$('matchedTable').innerHTML='<table><thead><tr><th>Measure</th><th>selected</th><th>d=0</th><th>difference</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${escapeHtml(r.label)}</td><td>${fmt(r.selected)}</td><td>${fmt(r.baseline)}</td><td>${finite(r.selected)&&finite(r.baseline)?fmt(Number(r.selected)-Number(r.baseline)):'—'}</td></tr>`).join('')+'</tbody></table>';const keys=['private_A','belief_A','public_F','advice','conflict','override'];Plotly.react('matchedPlot',[{type:'bar',name:ctx.d_inactive?'oracle · d inactive':`selected d=${fmt(DATA.ds[di])}`,x:keys.map(k=>METRICS[k][0].replace(/^Final /,'')),y:keys.map(k=>metricValue(k,selectedD(),ti)),marker:{color:'#49c7d5'}},{type:'bar',name:'matched d=0',x:keys.map(k=>METRICS[k][0].replace(/^Final /,'')),y:keys.map(k=>metricValue(k,baseD,ti)),marker:{color:'#f0ad63'}}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:68,r:15,t:28,b:110},barmode:'group',yaxis:{title:axisTitle('Endpoint probability / accuracy'),range:[0,1],gridcolor:'#35526a'},xaxis:{tickangle:-18},legend:{orientation:'h',y:1.15}},plotConfig);$('matchBadge').textContent=ctx.d_inactive?'No d contrast':'same model · scenario · tau';const reset=ctx.model==='reset';$('matchedNote').className='status'+(reset?' warning':'');$('matchedNote').textContent=ctx.d_inactive?'The oracle gate does not use inherited d; matched cells are duplicates, not a deference contrast.':reset?'This is the explicit reset-at-maturation ablation. Neither side is a retained-private-learning baseline after maturation.':'Both cells retain private ledger u through maturation. At d=0, testimony does not alter behavior or b, so u=b exactly; the comparison does not force private learners to relearn.'}

  function trajectoryPlots(){Plotly.react('populationPlot',[trace('F','Juveniles F'),trace('A','Adults A'),trace('N','Total N'),{...trace('N','Matched d=0 N',0,ti,ctx,{dash:'dot'}),line:{color:'#9baeb8',dash:'dot',width:2}}],layout('Continuous density'),plotConfig);Plotly.react('ledgerPlot',[trace('private_F','Juvenile private u'),trace('belief_F','Juvenile held b'),trace('private_A','Adult private u'),trace('belief_A','Adult held b')],layout('Accuracy',{yaxis:{title:axisTitle('Accuracy'),range:[0,1],gridcolor:'#35526a'}}),plotConfig);Plotly.react('behaviorPlot',[trace('public_F','Public action'),trace('advice','Teacher/advice'),trace('conflict','Conflict exposure'),trace('override','Override | conflict')],layout('Probability / accuracy',{yaxis:{title:axisTitle('Probability / accuracy'),range:[0,1],gridcolor:'#35526a'}}),plotConfig);const cost=trace('query_cost','Aggregate query-cost flow');cost.yaxis='y2';Plotly.react('queryPlot',[trace('query_F','Juvenile query rate'),trace('query_A','Adult query rate'),trace('query_rate','Population query rate'),cost],layout('Query rate per capita',{margin:{l:76,r:82,t:28,b:58},yaxis2:{title:axisTitle('Aggregate query-cost flow'),overlaying:'y',side:'right',showgrid:false,zeroline:true,zerolinecolor:'#668aa0'}}),plotConfig)}

  function normalizedDist(stage){const raw=ctx[stage][cellIndex(selectedD(),ti,ctx)],den=series(stage==='distF'?'F':'A',selectedD(),ti);return raw.map((row,i)=>row.map(x=>finite(den[i])&&Number(den[i])>0?Number(x)/Number(den[i]):null))}
  function distributionPlots(){const f=normalizedDist('distF'),a=normalizedDist('distA'),asScoreRows=m=>DATA.scores.map((_,j)=>m.map(row=>row[j]));const dl=(stage)=>({paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:70,r:22,t:28,b:58},xaxis:{title:axisTitle('Model time'),gridcolor:'#35526a'},yaxis:{title:axisTitle(`Held-conviction score b · ${stage}`),tickmode:'array',tickvals:DATA.scores,gridcolor:'#35526a'}});Plotly.react('distFPlot',[{type:'heatmap',x:DATA.t,y:DATA.scores,z:asScoreRows(f),zmin:0,zmax:1,colorscale:'Viridis',colorbar:{title:axisTitle('Stage fraction')},hovertemplate:'t=%{x:.4g}<br>b=%{y}<br>juvenile fraction=%{z:.6f}<extra></extra>'}],dl('juveniles F'),plotConfig);Plotly.react('distAPlot',[{type:'heatmap',x:DATA.t,y:DATA.scores,z:asScoreRows(a),zmin:0,zmax:1,colorscale:'Viridis',colorbar:{title:axisTitle('Stage fraction')},hovertemplate:'t=%{x:.4g}<br>b=%{y}<br>adult fraction=%{z:.6f}<extra></extra>'}],dl('adults A'),plotConfig);distributionCursor(f,a)}
  function distributionCursor(f=normalizedDist('distF'),a=normalizedDist('distA')){Plotly.react('distCursorPlot',[{type:'bar',name:'Juveniles F',x:DATA.scores,y:f[cursor],marker:{color:'#49c7d5'}},{type:'bar',name:'Adults A',x:DATA.scores,y:a[cursor],marker:{color:'#f0ad63'}}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:72,r:18,t:28,b:58},barmode:'group',xaxis:{title:axisTitle(`Held-conviction score b at t=${fmt(DATA.t[cursor])}`),tickmode:'array',tickvals:DATA.scores,gridcolor:'#35526a'},yaxis:{title:axisTitle('Within-stage fraction'),range:[0,1],gridcolor:'#35526a'},legend:{orientation:'h',y:1.16}},plotConfig)}

  function snapshot(){const i=cursor,F=series('F')[i],A=series('A')[i],N=series('N')[i],M=series('M')[i];$('timeLabel').textContent=`t=${fmt(DATA.t[i])}`;$('FNow').textContent=fmt(F);$('ANow').textContent=fmt(A);$('MNow').textContent=`flow ${fmt(M)}`;$('NNow').textContent=fmt(N);$('privateNow').textContent=fmt(series('private_A')[i]);$('beliefNow').textContent=fmt(series('belief_A')[i]);$('adviceNow').textContent=fmt(series('advice')[i]);$('overrideNow').textContent=fmt(series('override')[i]);$('queryCostNow').textContent=fmt(series('query_cost')[i]);$('FBar').style.width=`${finite(N)&&N>0?100*F/N:0}%`;$('ABar').style.width=`${finite(N)&&N>0?100*A/N:0}%`;$('scrub').value=i;$('timeOut').value=fmt(DATA.t[i]);for(const id of ['populationPlot','ledgerPlot','behaviorPlot','queryPlot'])if($(id).data)Plotly.relayout(id,{shapes:eventShapes()});distributionCursor();Object.assign(state,{cursor})}

  function pinKey(p){return `${p.model}|${p.scenario}|${p.di}|${p.ti}`}
  function addPin(p){if(!pins.some(x=>pinKey(x)===pinKey(p)))pins.push(p);if(pins.length>10)pins.shift()}
  function pinContext(p){return DATA.contexts.find(c=>c.model===p.model&&c.scenario===p.scenario)}
  function renderPins(){const traces=pins.map((p,i)=>{const c=pinContext(p),d=c.d_inactive?0:p.di;return {type:'scatter',mode:'lines',name:`${i+1} ${MODEL_LABELS[p.model]} · ${SCENARIO_LABELS[p.scenario]} · d=${c.d_inactive?'—':fmt(DATA.ds[p.di])} · tau=${fmt(DATA.taus[p.ti])}`,x:DATA.t,y:series('N',d,p.ti,c),line:{width:2}}});Plotly.react('pinPlot',traces,layout('Total population density',{shapes:[]}),plotConfig);$('pins').innerHTML='<table><thead><tr><th>#</th><th>model</th><th>scenario</th><th>d</th><th>tau</th><th>rT</th></tr></thead><tbody>'+pins.map((p,i)=>{const c=pinContext(p),d=c.d_inactive?0:p.di;return `<tr><td>${i+1}</td><td>${escapeHtml(MODEL_LABELS[p.model])}</td><td>${escapeHtml(SCENARIO_LABELS[p.scenario])}</td><td>${c.d_inactive?'—':fmt(DATA.ds[p.di])}</td><td>${fmt(DATA.taus[p.ti])}</td><td>${fmt(metricValue('rT',d,p.ti,c))}</td></tr>`}).join('')+'</tbody></table>';$('pinCount').textContent=`${pins.length} pinned`}

  function scenarioPanel(){const segments=ctx.segments;$('scenarioTable').innerHTML='<table><thead><tr><th>start</th><th>true state theta</th><th>actual P(cue +)</th></tr></thead><tbody>'+segments.map(s=>`<tr><td>${fmt(s[0])}</td><td>${s[1]>0?'+1':'−1'}</td><td>${fmt(s[2])}</td></tr>`).join('')+'</tbody></table>';$('scenarioNote').textContent=SCENARIO_EXPLAIN[ctx.scenario];const retained=ctx.model!=='reset';const detail={retained:retained?'u and b pass through maturation':'u and b reset to 0 at maturation',adult_mode:ctx.config.adult_mode,oracle_privileged:ctx.model==='oracle',private_cue_property_p:ctx.config.p,access:ctx.config.access,load_exposure_divisor:ctx.config.load,score_bound_H:ctx.config.H};$('architectureNote').textContent=ctx.model==='frozen'?'Adult private query rate is imposed as zero after maturation; “frozen” is not inferred from d or b.':ctx.model==='audit'?'Adult queries are full at low |b| and occur at the configured floor above the audit threshold.':ctx.model==='oracle'?'The oracle reads true current teacher reliability and compares it with a finite-memory private proxy. d is inactive.':ctx.model==='reset'?'This is the causal reset ablation; it deliberately removes both u and b at maturation.':'Adults continue private queries; juveniles and adults retain u and b across maturation.';$('invariants').textContent=JSON.stringify(detail,null,2)}

  function hypotheses(){ $('hypotheses').innerHTML=DATA.hypotheses.map(h=>`<article class="hypothesis"><h3>${escapeHtml(h.id)} · ${escapeHtml(h.status||'predeclared')}</h3><p>${escapeHtml(h.claim||h.text)}</p></article>`).join('');$('counts').textContent=JSON.stringify(DATA.counts,null,2);const s=DATA.supplements||{};$('supplementSummary').textContent=JSON.stringify(Object.fromEntries(Object.entries(s).map(([k,v])=>[k,v?{available:true,keys:Object.keys(v)}:{available:false}])),null,2)}

  const MECH_METRICS={N:'Final population N',rT:'Finite-horizon growth rT',belief_A:'Adult held accuracy',public_F:'Public action accuracy',wrong_confidence:'Wrong high-depth adults',cumulative_query_cost:'Cumulative query-cost flow'};
  function setupMechanisms(){const m=DATA.supplements?.mechanisms;if(!m?.rows?.length)return;$('mechanismSection').hidden=false;const vals=k=>[...new Set(m.rows.map(r=>r[k]))].sort((a,b)=>typeof a==='number'?a-b:String(a).localeCompare(String(b)));for(const x of vals('scenario'))$('mechScenario').add(new Option(SCENARIO_LABELS[x]||x,x));for(const x of vals('d'))$('mechD').add(new Option(String(x),String(x)));for(const x of vals('tau'))$('mechTau').add(new Option(String(x),String(x)));for(const [k,v] of Object.entries(MECH_METRICS))$('mechMetric').add(new Option(v,k));$('mechScenario').value='stable';$('mechD').value='0.5';$('mechTau').value='3';$('mechMetric').value='N';for(const id of ['mechScenario','mechD','mechTau','mechMetric'])$(id).addEventListener('change',renderMechanisms);renderMechanisms()}
  function renderMechanisms(){const m=DATA.supplements.mechanisms,scenario=$('mechScenario').value,d=Number($('mechD').value),tau=Number($('mechTau').value),key=$('mechMetric').value,order=['neither','action_only','storage_only','both','conflict_storage'],rows=m.rows.filter(r=>r.scenario===scenario&&r.d===d&&r.tau===tau).sort((a,b)=>order.indexOf(a.variant)-order.indexOf(b.variant));Plotly.react('mechanismPlot',[{type:'bar',x:rows.map(r=>r.variant.replaceAll('_',' ')),y:rows.map(r=>r[key]),marker:{color:rows.map(r=>r.variant==='both'?'#49c7d5':r.variant==='neither'?'#9baeb8':'#f0ad63')},hovertemplate:`%{x}<br>${escapeHtml(MECH_METRICS[key])}=%{y:.7g}<extra></extra>`}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:76,r:16,t:28,b:86},xaxis:{title:axisTitle('Storage / action mechanism'),tickangle:-16},yaxis:{title:axisTitle(MECH_METRICS[key]),gridcolor:'#35526a'}},plotConfig);$('mechanismTable').innerHTML='<table><thead><tr><th>variant</th><th>belief A</th><th>public F</th><th>override | conflict</th><th>N</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${escapeHtml(r.variant)}</td><td>${fmt(r.belief_A)}</td><td>${fmt(r.public_F)}</td><td>${fmt(r.override)}</td><td>${fmt(r.N)}</td></tr>`).join('')+'</tbody></table>';$('mechanismNote').textContent=`${m.definition} “Action only” changes current choice without storing testimony; “storage only” changes b without current override. These are imposed causal switches, not inferred latent traits.`}

  const SOURCE_METRICS={delta_rT:'Matched delta rT',delta_N:'Matched final population delta',delta_accuracy:'Matched adult accuracy delta'};
  function setupSourceConditions(){const s=DATA.supplements?.source_conditions;if(!s?.contrasts?.length)return;$('sourceSection').hidden=false;for(const x of [...new Set(s.contrasts.map(r=>r.mode))])$('sourceMode').add(new Option(MODEL_LABELS[x]||x,x));for(const x of s.costs)$('sourceCost').add(new Option(String(x),String(x)));for(const [k,v] of Object.entries(SOURCE_METRICS))$('sourceMetric').add(new Option(v,k));$('sourceMode').value='retained';$('sourceCost').value='0.02';$('sourceMetric').value='delta_rT';for(const id of ['sourceMode','sourceCost','sourceMetric'])$(id).addEventListener('change',renderSourceConditions);renderSourceConditions()}
  function renderSourceConditions(){const s=DATA.supplements.source_conditions,mode=$('sourceMode').value,cost=Number($('sourceCost').value),key=$('sourceMetric').value,rows=s.contrasts.filter(r=>r.mode===mode&&r.cost===cost),z=s.access_grid.map(access=>s.p_grid.map(p=>rows.find(r=>r.access===access&&r.p===p)?.[key]??null)),vals=z.flat().filter(finite).map(Number),lim=vals.length?Math.max(...vals.map(Math.abs)):1;Plotly.react('sourcePlot',[{type:'heatmap',x:s.p_grid,y:s.access_grid,z,zmin:-lim,zmax:lim,colorscale:[[0,'#a9455d'],[.5,'#f1f2ee'],[1,'#277fa4']],colorbar:{title:axisTitle(SOURCE_METRICS[key])},hovertemplate:`private cue p=%{x:.3f}<br>access=%{y:.4f}<br>${escapeHtml(SOURCE_METRICS[key])}=%{z:.7g}<extra></extra>`}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:82,r:34,t:28,b:62},xaxis:{title:axisTitle('Externally supplied cue quality p'),gridcolor:'#35526a'},yaxis:{title:axisTitle('Private information access'),type:'log',tickmode:'array',tickvals:[.05,.1,.2,.5,1],ticktext:['0.05','0.1','0.2','0.5','1'],gridcolor:'#35526a'}},plotConfig);const extrema=[...rows].sort((a,b)=>Number(b[key])-Number(a[key]));$('sourceTable').innerHTML='<table><thead><tr><th>cell</th><th>p</th><th>access</th><th>contrast</th><th>private N</th><th>social N</th></tr></thead><tbody>'+[...extrema.slice(0,5),...extrema.slice(-5).reverse()].map((r,i)=>`<tr><td>${i<5?'largest':'smallest'}</td><td>${fmt(r.p)}</td><td>${fmt(r.access)}</td><td>${fmt(r[key])}</td><td>${fmt(r.private_N)}</td><td>${fmt(r.social_N)}</td></tr>`).join('')+'</tbody></table>';$('sourceNote').textContent=`${s.scope} Cue quality and access are environmental inputs shared by matched d genotypes. Values are finite-horizon contrasts, not invasion fitness.`}

  const REP_METRICS={end_accuracy_mean:'End held-belief accuracy',end_private_accuracy_mean:'End private-ledger accuracy',end_wrong_high_confidence_mean:'End wrong high-confidence fraction',total_adult_queries_post_founder_mean:'Adult queries after founders',mean_conflict_override_rate_mean:'Conflict override rate'};
  function setupRepertoire(){const rep=DATA.supplements?.repertoire;if(!rep?.aggregates?.length)return;$('repertoireSection').hidden=false;const vals=k=>[...new Set(rep.aggregates.map(r=>r[k]))].sort((a,b)=>typeof a==='number'?a-b:String(a).localeCompare(String(b)));for(const x of vals('D'))$('repD').add(new Option(String(x),String(x)));for(const x of vals('p'))$('repP').add(new Option(String(x),String(x)));for(const x of vals('environment'))$('repEnv').add(new Option(x==='quarter_flip'?'Quarter-context truth flip':x,x));for(const [k,v] of Object.entries(REP_METRICS))$('repMetric').add(new Option(v,k));$('repD').value=String(Math.max(...vals('D')));$('repP').value=String(vals('p')[Math.floor(vals('p').length/2)]);$('repEnv').value='stable';$('repMetric').value='end_accuracy_mean';for(const id of ['repD','repP','repEnv','repMetric'])$(id).addEventListener('change',renderRepertoire);renderRepertoire()}
  function renderRepertoire(){const rep=DATA.supplements.repertoire,D=Number($('repD').value),p=Number($('repP').value),env=$('repEnv').value,key=$('repMetric').value,rows=rep.aggregates.filter(r=>r.D===D&&r.p===p&&r.environment===env),policies=[...new Set(rows.map(r=>r.policy))];const traces=policies.map((policy,i)=>{const rr=rows.filter(r=>r.policy===policy).sort((a,b)=>a.d-b.d);return {type:'scatter',mode:'lines+markers',name:policy.replaceAll('_',' '),x:rr.map(r=>r.d),y:rr.map(r=>r[key]),error_y:{type:'data',array:rr.map(r=>r[key.replace(/_mean$/,'_sd')]??0),visible:true},line:{width:2}}});Plotly.react('repertoirePlot',traces,{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:78,r:18,t:28,b:60},xaxis:{title:axisTitle('Deference d'),range:[0,1],gridcolor:'#35526a'},yaxis:{title:axisTitle(REP_METRICS[key]),gridcolor:'#35526a'},legend:{orientation:'h',y:1.17}},plotConfig);$('repertoireTable').innerHTML='<table><thead><tr><th>policy</th><th>d</th><th>mean</th><th>SD</th><th>n seeds</th></tr></thead><tbody>'+rows.sort((a,b)=>a.policy.localeCompare(b.policy)||a.d-b.d).map(r=>`<tr><td>${escapeHtml(r.policy)}</td><td>${fmt(r.d)}</td><td>${fmt(r[key])}</td><td>${fmt(r[key.replace(/_mean$/,'_sd')])}</td><td>${r.n_seeds}</td></tr>`).join('')+'</tbody></table>';const lookup=(environment,policy)=>rep.aggregates.find(r=>r.D===4&&r.p===.55&&r.d===1&&r.environment===environment&&r.policy===policy)?.end_accuracy_mean,frozenStable=lookup('stable','frozen'),frozenFlip=lookup('quarter_flip','frozen'),updateFlip=lookup('quarter_flip','retained_update');$('repertoireNote').textContent=`D=${D}, cue p=${p}, ${env.replaceAll('_',' ')}. Error bars are ±1 seed SD across ${rows[0]?.n_seeds||'stored'} histories, not confidence intervals. Common random numbers pair matched conditions; this benchmark has no demographic fitness or selection. Stored D=4, p=.55, d=1 runs show frozen highest in the stable world (${fmt(frozenStable)}) but below retained updating after the quarter-context flip (${fmt(frozenFlip)} vs ${fmt(updateFlip)}); changing D does not uniformly increase the social benefit.`}

  const TUTOR_METRICS={delta_end_accuracy_mean:'Filter delta end accuracy',delta_end_wrong_high_confidence_mean:'Filter delta wrong high-confidence',delta_advice_accuracy_conditional_mean:'Filter delta advice accuracy | endorsement',delta_total_actual_endorsements_mean:'Filter delta actual endorsements',delta_mean_search_availability_mean:'Filter delta search availability',delta_post_shock_mean_accuracy_mean:'Filter delta post-shock accuracy'};
  const mean=(rows,key)=>{const v=rows.map(r=>r[key]).filter(finite).map(Number);return v.length?v.reduce((a,b)=>a+b,0)/v.length:null};
  function setupTutors(){const t=DATA.supplements?.repertoire_tutors;if(!t?.pair_aggregates?.length)return;$('tutorSection').hidden=false;const vals=k=>[...new Set(t.pair_aggregates.map(r=>r[k]))].sort((a,b)=>typeof a==='number'?a-b:String(a).localeCompare(String(b)));for(const x of vals('D'))$('tutorD').add(new Option(String(x),String(x)));for(const x of vals('p'))$('tutorP').add(new Option(String(x),String(x)));for(const x of vals('environment'))$('tutorEnv').add(new Option(x==='quarter_flip'?'Quarter-context truth flip':x,x));for(const [k,v] of Object.entries(TUTOR_METRICS))$('tutorMetric').add(new Option(v,k));$('tutorD').value='4';$('tutorP').value='0.55';$('tutorEnv').value='quarter_flip';$('tutorMetric').value='delta_end_wrong_high_confidence_mean';for(const id of ['tutorD','tutorP','tutorEnv','tutorMetric'])$(id).addEventListener('change',renderTutors);renderTutors()}
  function renderTutors(){const t=DATA.supplements.repertoire_tutors,D=Number($('tutorD').value),p=Number($('tutorP').value),env=$('tutorEnv').value,key=$('tutorMetric').value,rows=t.pair_aggregates.filter(r=>r.D===D&&r.p===p&&r.environment===env),policies=[...new Set(rows.map(r=>r.policy))],sdKey=key.replace(/_mean$/,'_sd');const traces=policies.map((policy,i)=>{const rr=rows.filter(r=>r.policy===policy).sort((a,b)=>a.d-b.d);return {type:'scatter',mode:'lines+markers',name:policy.replaceAll('_',' '),x:rr.map(r=>r.d),y:rr.map(r=>r[key]),error_y:{type:'data',array:rr.map(r=>r[sdKey]??0),visible:true},line:{width:2}}});Plotly.react('tutorPlot',traces,{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:88,r:18,t:28,b:60},xaxis:{title:axisTitle('Deference d'),range:[0,1],gridcolor:'#35526a'},yaxis:{title:axisTitle(TUTOR_METRICS[key]+' · filtered minus random'),gridcolor:'#35526a',zeroline:true,zerolinecolor:'#edf5f8'},legend:{orientation:'h',y:1.17}},plotConfig);const summaries=rows.sort((a,b)=>a.policy.localeCompare(b.policy)||a.d-b.d).map(r=>{const raw=t.filter_pairs.filter(x=>x.D===D&&x.p===p&&x.environment===env&&x.policy===r.policy&&x.d===r.d);return {r,availability:[mean(raw,'random_mean_search_availability'),mean(raw,'filtered_mean_search_availability')],advice:[mean(raw,'random_advice_accuracy_conditional'),mean(raw,'filtered_advice_accuracy_conditional')],endorse:[mean(raw,'random_total_actual_endorsements'),mean(raw,'filtered_total_actual_endorsements')],wrongPool:mean(raw,'filtered_mean_qualifying_pool_wrong_share')}});$('tutorTable').innerHTML='<table><thead><tr><th>policy</th><th>d</th><th>selected delta</th><th>availability random→filter</th><th>advice accuracy random→filter</th><th>endorsements random→filter</th><th>wrong share in eligible pool</th></tr></thead><tbody>'+summaries.map(x=>`<tr><td>${escapeHtml(x.r.policy)}</td><td>${fmt(x.r.d)}</td><td>${fmt(x.r[key])} ± ${fmt(x.r[sdKey])}</td><td>${fmt(x.availability[0])} → ${fmt(x.availability[1])}</td><td>${fmt(x.advice[0])} → ${fmt(x.advice[1])}</td><td>${fmt(x.endorse[0])} → ${fmt(x.endorse[1])}</td><td>${fmt(x.wrongPool)}</td></tr>`).join('')+'</tbody></table>';$('tutorNote').textContent=`${t.exploratory_status} ${t.teacher_filter_definition.confidence_ge_2} ${t.teacher_filter_definition.caveat} Error bars are ±1 paired-seed SD across six histories. Positive wrong-high-confidence deltas mean the observable confidence filter leaves more wrong confident adults after the shock. ${t.model_scope}`}

  function setupBayes(){const b=DATA.supplements?.bayes_benchmark;if(!b?.rows?.length)return;$('bayesSection').hidden=false;for(const x of b.parameters.q0)$('bayesPrior').add(new Option(String(x),String(x)));for(const x of b.parameters.p)$('bayesP').add(new Option(String(x),String(x)));$('bayesPrior').value='0.95';$('bayesP').value='0.55';for(const id of ['bayesPrior','bayesP'])$(id).addEventListener('change',renderBayes);renderBayes()}
  function renderBayes(){const b=DATA.supplements.bayes_benchmark,q0=Number($('bayesPrior').value),p=Number($('bayesP').value),rows=b.rows.filter(r=>r.q0===q0&&r.p===p).sort((a,c)=>a.n-c.n),last=rows.at(-1);Plotly.react('bayesPlot',[{type:'scatter',mode:'lines',name:'Exact calibrated Bayes',x:rows.map(r=>r.n),y:rows.map(r=>r.bayes_accuracy),line:{color:'#70d1a0',width:3}},{type:'scatter',mode:'lines',name:'Bounded unit-step score',x:rows.map(r=>r.n),y:rows.map(r=>r.bounded_accuracy),line:{color:'#f0ad63',width:3}},{type:'scatter',mode:'lines',name:'Initial calibrated prior',x:rows.map(r=>r.n),y:rows.map(()=>q0),line:{color:'#edf5f8',dash:'dot',width:2}}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:78,r:18,t:28,b:60},xaxis:{title:axisTitle('Number of conditionally independent cues n'),gridcolor:'#35526a'},yaxis:{title:axisTitle('Expected decision accuracy'),range:[0.5,1],gridcolor:'#35526a'},legend:{orientation:'h',y:1.17}},plotConfig);$('bayesTable').innerHTML=`<table><thead><tr><th>q0</th><th>p</th><th>n</th><th>Bayes</th><th>bounded score</th><th>bounded regret</th></tr></thead><tbody><tr><td>${fmt(q0)}</td><td>${fmt(p)}</td><td>${last.n}</td><td>${fmt(last.bayes_accuracy,6)}</td><td>${fmt(last.bounded_accuracy,6)}</td><td>${fmt(last.bounded_regret_vs_bayes,6)}</td></tr></tbody></table><h3>All detected prior-erosion cases</h3><table><thead><tr><th>q0</th><th>p</th><th>worst n</th><th>bounded</th><th>loss vs prior</th><th>Bayes</th></tr></thead><tbody>${b.erosion_cases.map(r=>`<tr><td>${fmt(r.q0)}</td><td>${fmt(r.p)}</td><td>${r.minimum_n}</td><td>${fmt(r.minimum_bounded_accuracy,6)}</td><td>${fmt(r.erosion_below_prior,6)}</td><td>${fmt(r.bayes_accuracy_at_same_n,6)}</td></tr>`).join('')}</tbody></table>`;$('bayesNote').textContent=`${b.summary.claim_limit} Selected q0=${q0}, p=${p}, n=${last.n}: bounded=${fmt(last.bounded_accuracy,6)} versus Bayes=${fmt(last.bayes_accuracy,6)}. All ${b.checks.length} exact checks passed. This comparator assumes a stable binary task, calibrated prior, known cue accuracy, and conditional independence; it contains no demography, social transmission, or query cost and makes no human optimality claim.`}

  function setupSensitivity(){const cm=DATA.supplements?.cost_memory,ref=DATA.supplements?.refinement;if(!cm?.rows?.length&&!ref?.length)return;$('sensitivitySection').hidden=false;if(cm?.rows?.length){for(const x of [...new Set(cm.rows.map(r=>r.H))].sort((a,b)=>a-b))$('memoryH').add(new Option(String(x),String(x)));for(const x of [...new Set(cm.rows.map(r=>r.query_cost))].sort((a,b)=>a-b))$('memoryCost').add(new Option(String(x),String(x)));$('memoryH').value='4';$('memoryCost').value='0.02';for(const id of ['memoryH','memoryCost'])$(id).addEventListener('change',renderSensitivity)}renderSensitivity()}
  function renderSensitivity(){const cm=DATA.supplements?.cost_memory,ref=DATA.supplements?.refinement||[],H=Number($('memoryH').value),cost=Number($('memoryCost').value),rows=cm?.rows?.filter(r=>r.H===H&&r.query_cost===cost)||[],groups=[];for(const model of ['retained','frozen','audit'])for(const tau of [1,3,8]){const a=rows.find(r=>r.model===model&&r.tau===tau&&r.d===0),b=rows.find(r=>r.model===model&&r.tau===tau&&r.d===1);if(a&&b)groups.push({model,tau,a,b})}$('costMemoryTable').innerHTML='<table><thead><tr><th>model</th><th>tau</th><th>N d0</th><th>N d1</th><th>delta N</th><th>accuracy d0→d1</th><th>adult query d0→d1</th></tr></thead><tbody>'+groups.map(x=>`<tr><td>${escapeHtml(x.model)}</td><td>${fmt(x.tau)}</td><td>${fmt(x.a.N)}</td><td>${fmt(x.b.N)}</td><td>${fmt(x.b.N-x.a.N)}</td><td>${fmt(x.a.accuracy)} → ${fmt(x.b.accuracy)}</td><td>${fmt(x.a.query_A)} → ${fmt(x.b.query_A)}</td></tr>`).join('')+'</tbody></table>';$('costMemoryNote').textContent=`H=${H}, query cost=${cost}. ${cm?.purpose||''} These separate-population abundance rows are not shared-culture selection.`;$('refinementTable').innerHTML='<table><thead><tr><th>model</th><th>scenario</th><th>d</th><th>tau</th><th>N</th><th>boundary?</th></tr></thead><tbody>'+ref.map(r=>`<tr><td>${escapeHtml(r.model)}</td><td>${escapeHtml(r.scenario)}</td><td>${fmt(r.d)}</td><td>${fmt(r.tau)}</td><td>${fmt(r.N)}</td><td>${r.tau_domain_boundary?'tau ':''}${r.d_boundary?'d':''}</td></tr>`).join('')+'</tbody></table>';const cv=DATA.supplements?.dynamic_convergence;$('convergenceNote').textContent=cv?`Dynamic invasion step-halving check: maximum absolute difference ${fmt(cv.max_absolute_difference,6)} between dt=${cv.dt} and ${cv.half_dt}; stored at full precision. Refinements remain local abundance diagnostics, not ESS proofs.`:'No dynamic convergence supplement was embedded.'}

  function setupHistories(){const h=DATA.supplements?.histories_summary;if(!h?.rows?.length)return;$('historiesSection').hidden=false;for(const x of [...new Set(h.rows.map(r=>r.phase))])$('historyPhase').add(new Option(x,x));for(const x of [...new Set(h.rows.map(r=>r.model))])$('historyModel').add(new Option(MODEL_LABELS[x]||x,x));$('historyPhase').value='confirm';$('historyModel').value='retained';for(const id of ['historyPhase','historyModel'])$(id).addEventListener('change',renderHistories);renderHistories()}
  function renderHistories(){const h=DATA.supplements.histories_summary,phase=$('historyPhase').value,model=$('historyModel').value,rows=h.rows.filter(r=>r.phase===phase&&r.model===model),worlds=['real_changes','channel_changes'],traces=worlds.map((world,i)=>{const rr=rows.filter(r=>r.world===world).sort((a,b)=>a.tau-b.tau);return {type:'scatter',mode:'lines+markers',name:world.replaceAll('_',' '),x:rr.map(r=>r.tau),y:rr.map(r=>r.mean),error_y:{type:'data',array:rr.map(r=>1.96*r.se),visible:true},line:{color:i?'#f0ad63':'#49c7d5',width:2}}});Plotly.react('historiesPlot',traces,{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:90,r:18,t:28,b:60},xaxis:{title:axisTitle('Mean maturation tau · log scale'),type:'log',tickmode:'array',tickvals:[1,3,8],ticktext:['1','3','8'],gridcolor:'#35526a'},yaxis:{title:axisTitle('Mean paired finite-horizon delta r600'),gridcolor:'#35526a',zeroline:true,zerolinecolor:'#edf5f8'},legend:{orientation:'h',y:1.17}},plotConfig);$('historiesTable').innerHTML='<table><thead><tr><th>world</th><th>tau</th><th>mean</th><th>SE</th><th>positive / n</th></tr></thead><tbody>'+rows.sort((a,b)=>a.world.localeCompare(b.world)||a.tau-b.tau).map(r=>`<tr><td>${escapeHtml(r.world)}</td><td>${fmt(r.tau)}</td><td>${fmt(r.mean)}</td><td>${fmt(r.se)}</td><td>${r.positive} / ${r.n}</td></tr>`).join('')+'</tbody></table>';$('historiesNote').textContent=`${h.scope} Error bars are normal-approximation 95% intervals from across-history SE only. These finite-horizon paired contrasts are not invasion fitness and truth-dependent demography can separate otherwise identical learner observations.`}

  function setupSelection(){const s=DATA.supplements?.selection;if(!s?.architecture_invasion?.length||!s?.competition?.length)return;$('selectionSection').hidden=false;const scenarios=[...new Set(s.architecture_invasion.map(r=>r.scenario))];for(const x of scenarios)$('selectionScenario').add(new Option(SCENARIO_LABELS[x]||x,x));$('selectionScenario').value='stable';for(const id of ['selectionScenario','competitionKind'])$(id).addEventListener('change',renderSelection);renderSelection()}
  function renderSelection(){const s=DATA.supplements.selection,scenario=$('selectionScenario').value,kind=$('competitionKind').value,order=['private','social','frozen','audit'],rows=s.architecture_invasion.filter(r=>r.scenario===scenario),z=order.map(res=>order.map(mut=>rows.find(r=>r.resident===res&&r.mutant===mut)?.rate??null)),vals=z.flat().filter(finite).map(Number),lim=vals.length?Math.max(...vals.map(Math.abs)):1;Plotly.react('architectureInvasionPlot',[{type:'heatmap',x:order,y:order,z,zmin:-lim,zmax:lim,colorscale:[[0,'#a9455d'],[.5,'#f1f2ee'],[1,'#277fa4']],colorbar:{title:axisTitle('Invasion rate')},hovertemplate:'resident=%{y}<br>mutant=%{x}<br>rate=%{z:.7g}<extra></extra>'}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:94,r:30,t:24,b:62},xaxis:{title:axisTitle('Rare mutant architecture'),gridcolor:'#35526a'},yaxis:{title:axisTitle('Resident architecture'),gridcolor:'#35526a'}},plotConfig);const comp=s.competition.find(r=>r.scenario===scenario&&r.kind===kind);if(comp){const labels=kind==='architectures'?['private d=0','social d=1','frozen d=1','audit d=1']:comp.d.map((d,i)=>`d=${fmt(d)}, tau=${fmt(comp.tau[i])}`);Plotly.react('competitionPlot',[{type:'heatmap',x:comp.t,y:labels,z:comp.frequency,zmin:0,zmax:1,colorscale:[[0,'#07131f'],[.35,'#277fa4'],[1,'#ffd166']],colorbar:{title:axisTitle('Frequency')},hovertemplate:'%{y}<br>t=%{x:.4g}<br>frequency=%{z:.6f}<extra></extra>'}],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8',size:11},margin:{l:150,r:28,t:24,b:62},xaxis:{title:axisTitle('Model time'),gridcolor:'#35526a'},yaxis:{title:axisTitle('Inherited genotype / architecture'),automargin:true}},plotConfig)}else Plotly.purge('competitionPlot');$('selectionNote').textContent=`${s.resident_definition} ${s.dynamic_definition} Competition frequencies are finite-time outcomes${comp?.mutation?` with uniform mutation ${comp.mutation}`:' with zero mutation'}, not an ESS proof or fixation probability.`;renderSelectionAddendum()}

  function renderSelectionAddendum(){const refinement=DATA.supplements?.selection_refinement||[],mechanism=DATA.supplements?.mechanism_invasion,replacement=DATA.supplements?.frozen_replacement;$('selectionRefinementTable').innerHTML='<table><thead><tr><th>scenario</th><th>expanded root tau</th><th>primary [0.5,12] candidate</th><th>N at root</th><th>largest sampled invader</th></tr></thead><tbody>'+refinement.map(r=>{const root=r.roots[0],primary=root.main_domain?fmt(root.tau,7):`${fmt(r.primary_domain[0])} · lower boundary`;return `<tr><td>${escapeHtml(r.scenario)}</td><td>${fmt(root.tau,7)}</td><td>${primary}</td><td>${fmt(root.N)}</td><td>${fmt(root.max_sampled_invader[2],6)}</td></tr>`}).join('')+'</tbody></table>';const mechanismRows=(mechanism?.rows||[]).filter(r=>r.resident_d===0&&r.mutant_d===1&&['both','action_only'].includes(r.variant));$('mechanismInvasionTable').innerHTML='<table><thead><tr><th>scenario</th><th>mutant mechanism</th><th>resident d</th><th>mutant d</th><th>tau</th><th>resident N</th><th>invasion</th></tr></thead><tbody>'+mechanismRows.map(r=>`<tr><td>${escapeHtml(r.scenario)}</td><td>${escapeHtml(r.variant)}</td><td>${fmt(r.resident_d)}</td><td>${fmt(r.mutant_d)}</td><td>${fmt(r.tau)}</td><td>${fmt(r.resident_N)}</td><td>${fmt(r.invasion,6)}</td></tr>`).join('')+'</tbody></table>';$('selectionAddendumNote').textContent=`${refinement[0]?.scope||''} For noisy evidence the expanded-domain root is ${fmt(refinement.find(r=>r.scenario==='noisy')?.roots?.[0]?.tau,7)}, outside the primary [0.5,12] sweep, so tau=0.5 is the within-domain boundary candidate. ${mechanism?.scope||''}`;if(!replacement)return;const audit={type:'scatter',mode:'lines',name:'Audit resident lineage',x:replacement.t,y:replacement.frequency[0],line:{color:'#49c7d5',width:3}},frozen={type:'scatter',mode:'lines',name:'Initially rare frozen lineage',x:replacement.t,y:replacement.frequency[1],line:{color:'#f0ad63',width:3}},pop={type:'scatter',mode:'lines',name:'Total N',x:replacement.t,y:replacement.N,yaxis:'y2',line:{color:'#edf5f8',dash:'dot',width:2}};Plotly.react('replacementPlot',[audit,frozen,pop],{paper_bgcolor:'#102337',plot_bgcolor:'#102337',font:{color:'#edf5f8'},margin:{l:72,r:82,t:28,b:62},xaxis:{title:axisTitle('Model time'),gridcolor:'#35526a'},yaxis:{title:axisTitle('Lineage frequency'),range:[0,1],gridcolor:'#35526a'},yaxis2:{title:axisTitle('Total population N'),overlaying:'y',side:'right',showgrid:false},legend:{orientation:'h',y:1.17}},plotConfig);$('replacementControls').innerHTML='<table><thead><tr><th>query cost</th><th>resident</th><th>mutant</th><th>invasion</th><th>resident N</th></tr></thead><tbody>'+replacement.invasion_controls.map(r=>`<tr><td>${fmt(r.query_cost)}</td><td>${escapeHtml(r.resident)}</td><td>${escapeHtml(r.mutant)}</td><td>${fmt(r.invasion,7)}</td><td>${fmt(r.resident_N)}</td></tr>`).join('')+'</tbody></table>';$('replacementNote').textContent=`Exploratory measured competition in noisy p=0.55 with imposed audit resident and frozen mutant architectures, matched d=1 and tau=3, query cost 0.02, and no mutation. Frozen starts at 0.1% and reaches ${fmt(100*replacement.final_frozen_fraction)}% by t=${fmt(replacement.t.at(-1))}; N changes from ${fmt(replacement.initial_N)} to ${fmt(replacement.final_N)}. At zero query cost the frozen invasion exponent is ${fmt(replacement.invasion_controls.find(r=>r.query_cost===0&&r.mutant==='frozen')?.invasion,7)}. This is finite-time replacement evidence for one assigned-policy pair, not a fixation claim, stochastic extinction result, or emergent dogmatism.`}

  function download(name,text,type){if(window.__captureDownload){window.__captureDownload(name,text,type);return}const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);$('message').textContent=`Prepared ${name}`}
  function csv(rows){if(!rows.length)return '';const keys=[...new Set(rows.flatMap(Object.keys))],q=v=>`"${String(v??'').replaceAll('"','""')}"`;return keys.map(q).join(',')+'\n'+rows.map(r=>keys.map(k=>q(typeof r[k]==='object'?JSON.stringify(r[k]):r[k])).join(',')).join('\n')+'\n'}
  function mapRows(){return DATA.ds.flatMap((d,dix)=>DATA.taus.map((tau,tix)=>({run_id:DATA.run_id,label:DATA.label,context_id:ctx.id,model:ctx.model,scenario:ctx.scenario,d:ctx.d_inactive?null:d,tau,...Object.fromEntries(Object.keys(ctx.metrics).map(k=>[k,metricValue(k,ctx.d_inactive?0:dix,tix)]))})))}
  function seriesRows(){return DATA.t.map((t,i)=>({run_id:DATA.run_id,label:DATA.label,...selectedRecord(),time:t,...Object.fromEntries(Object.keys(ctx.series).map(k=>[k,series(k)[i]??null]))}))}
  function wireExports(){const config=()=>JSON.stringify({...selectedRecord(),resident:ctx.resident},null,2),map=()=>mapRows(),ser=()=>seriesRows(),dist=()=>({run_id:DATA.run_id,label:DATA.label,...selectedRecord(),scores:DATA.scores,time:DATA.t,distF:ctx.distF[cellIndex(selectedD(),ti,ctx)],distA:ctx.distA[cellIndex(selectedD(),ti,ctx)]});$('configJson').onclick=()=>download('v5-config.json',config(),'application/json');$('configCsv').onclick=()=>download('v5-config.csv',csv([{...selectedRecord(),config:ctx.config,segments:ctx.segments}]),'text/csv');$('mapJson').onclick=()=>download('v5-map.json',JSON.stringify(map()),'application/json');$('mapCsv').onclick=()=>download('v5-map.csv',csv(map()),'text/csv');$('seriesJson').onclick=()=>download('v5-series.json',JSON.stringify(ser()),'application/json');$('seriesCsv').onclick=()=>download('v5-series.csv',csv(ser()),'text/csv');$('distJson').onclick=()=>download('v5-b-distributions.json',JSON.stringify(dist()),'application/json');$('allJson').onclick=()=>download('v5-selected-evidence.json',JSON.stringify({config:JSON.parse(config()),map:map(),series:ser(),distributions:dist()}),'application/json')}

  function refreshAll(){refreshControls();heatmap();matched();trajectoryPlots();distributionPlots();renderPins();scenarioPanel();snapshot()}
  function events(){$('model').onchange=()=>{di=0;cursor=0;refreshAll()};$('scenario').onchange=()=>{cursor=0;refreshAll()};$('metric').onchange=()=>{refreshControls();heatmap()};$('dSlider').oninput=e=>{di=Number(e.target.value);cursor=0;refreshAll()};$('tauSlider').oninput=e=>{ti=Number(e.target.value);cursor=0;refreshAll()};$('scrub').oninput=e=>{cursor=Number(e.target.value);snapshot()};$('play').onclick=()=>{clearInterval(timer);timer=setInterval(()=>{cursor=(cursor+Number($('speed').value))%DATA.t.length;snapshot()},120)};$('pause').onclick=()=>{clearInterval(timer);timer=null};$('restart').onclick=()=>{cursor=0;snapshot()};$('pinSelected').onclick=()=>{addPin({model:ctx.model,scenario:ctx.scenario,di:selectedD(),ti});renderPins()};$('pinMatched').onclick=()=>{for(const model of ['retained','frozen','audit'])addPin({model,scenario:ctx.scenario,di:model==='oracle'?0:selectedD(),ti});addPin({model:ctx.model,scenario:ctx.scenario,di:0,ti});renderPins()};$('resetPins').onclick=()=>{pins=[];renderPins()};wireExports()}

  async function init(){try{DATA=await embeddedData();window.DATA=DATA;populate();events();hypotheses();setupMechanisms();setupSourceConditions();setupRepertoire();setupTutors();setupBayes();setupHistories();setupSelection();setupSensitivity();refreshAll();$('loading').hidden=true;$('app').hidden=false;state.ready=true}catch(error){console.error(error);$('loading').innerHTML=`<div><h1>Dashboard could not open</h1><p class="error">${escapeHtml(error.message)}</p></div>`}}
  init();
  </script>
</body>
</html>
