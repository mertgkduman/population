";
async function embeddedData(){const bytes=Uint8Array.from(atob(EMBEDDED_GZIP_BASE64),c=>c.charCodeAt(0));const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return JSON.parse(await new Response(stream).text())}
let DATA,ctx,di=4,ti=5,cursor=0,pins=[],timer=null;window.AppState={};
const $=id=>document.getElementById(id),fmt=x=>x==null?'unavailable':Number(x).toLocaleString(undefined,{maximumSignificantDigits:5}),near=(a,x)=>a.reduce((best,v,i)=>Math.abs(v-x)<Math.abs(a[best]-x)?i:best,0);
const METRICS={mean_N:['Mean abundance · density','Post-burn-in average N, times 200–600; not a growth rate.'],delta_N:['Matched abundance advantage · density','Mean N minus d=0 at the same τ, plasticity and path; SE is paired across histories.'],adult_accuracy:['Adult belief accuracy · probability','Average accuracy of privately held adult conviction; advice includes a fixed 5% transmission error.'],private_accuracy:['Juvenile private accuracy · probability','Accuracy of retained private evidence, with cue quality fixed across all traits.'],public_accuracy:['Juvenile public accuracy · probability','Accuracy after action substitution; distinct from private belief.'],wrong_confidence:['Wrong confident adults · fraction','Adult fraction holding a wrong conviction with |b|>2.'],abundance_cv:['Abundance temporal CV','Relative fluctuation amplitude over times 200–600.'],r_T:['Finite-horizon log growth · 1/time','log[N(600)/N(0)]/600. Not a stationary low-density or invasion rate.'],tail_growth:['Tail log growth · 1/time','log[N(600)/N(200)]/400. Density limitation often makes this small.'],invasion_absolute:['Absolute mutant log growth · 1/time','Mutant log growth over 200–600 in a nonfeedback resident environment.'],invasion_relative:['Resident-relative invasion · 1/time','Absolute mutant growth minus resident log growth over the same window. Resident d=.5, τ=3, same adult plasticity.'],recovery_fraction:['Recovery before next flip · fraction','Fraction of post-burn-in flips reaching sampled adult accuracy ≥0.75 before the next flip; no-flip cells are missing.'],recovery_time:['Successful recovery delay · time','Mean delay among successful flips only; censoring is reported separately. Four-time-unit observation resolution.']};
const signed=k=>['delta_N','r_T','tail_growth','invasion_absolute','invasion_relative'].includes(k),prob=k=>['adult_accuracy','private_accuracy','public_accuracy','wrong_confidence','recovery_fraction'].includes(k);
const baseLayout={paper_bgcolor:'#112b3d',plot_bgcolor:'#112b3d',font:{color:'#e9f2f5'},margin:{l:68,r:35,t:20,b:57},legend:{orientation:'h',y:1.15},xaxis:{gridcolor:'#345164'},yaxis:{gridcolor:'#345164'}};
const cfg={responsive:true,displaylogo:false};
function layout(extra={}){return {...baseLayout,...extra,xaxis:{...baseLayout.xaxis,...extra.xaxis},yaxis:{...baseLayout.yaxis,...extra.yaxis}}}
function current(){return DATA.contexts.find(c=>c.eta_A===Number($('plasticity').value)&&c.kappa===Number($('kappa').value))}
const idx=()=>di*DATA.taus.length+ti;
function selected(){return {label:'simulation data',run_id:DATA.run_id,context_id:ctx.id,d:DATA.ds[di],tau:DATA.taus[ti],parameters:ctx.config,kappa:ctx.kappa,seeds:ctx.seeds,burn_in:200,horizon:600,solver:'RK4 dt=.1, exact environmental event splits',trajectory_view:$('view').value,illustrated_seed:65001,units:{time:'model_time',density:'continuous_population_density',rates:'1/model_time',plasticity:'encoding probability'},resident:ctx.resident}}
function series(k,c=ctx,i=idx()){return c.series[k][$('view').value==='mean'?'mean':'sample'][i]}
function truth(c,t){let theta=1;for(const s of c.paths[0]){if(s[0]>t)break;theta=s[1]}return theta}
function refreshControls(){ctx=current();$('dOut').textContent=fmt(DATA.ds[di]);$('tauOut').textContent=fmt(DATA.taus[ti]);$('dSlider').value=di;$('tauSlider').value=ti;$('selection').textContent=`d=${fmt(DATA.ds[di])}; τ=${fmt(DATA.taus[ti])}; adult η=${ctx.eta_A}; environmental κ=${ctx.kappa}. ${ctx.kappa===0?'Fixed environment; deterministic histories.':'Stochastic environment; 8 independent matched paths.'}`;$('configView').textContent=JSON.stringify(selected(),null,2);$('metricNote').textContent=METRICS[$('metric').value][1];Object.assign(AppState,{ctx:ctx.id,di,ti,cursor,ready:true});$('runId').textContent=`Run ${DATA.run_id} · ${DATA.contexts.length*DATA.ds.length*DATA.taus.length*DATA.seeds.length} isolated trajectories plus the same number of rare-mutant trajectories. Simulation data.`}
function heatmap(){const k=$('metric').value,z=DATA.taus.map((_,t)=>DATA.ds.map((_,d)=>ctx.metrics[k][d*DATA.taus.length+t]));const trace={type:'heatmap',x:DATA.ds,y:DATA.taus,z,hoverongaps:false,colorscale:signed(k)?'RdBu':'Viridis',reversescale:signed(k),colorbar:{title:{text:METRICS[k][0].split(' · ')[0]}},customdata:DATA.taus.map((_,t)=>DATA.ds.map((_,d)=>[ctx.metrics[k+'_se']?.[d*DATA.taus.length+t]??null,ctx.metrics[k+'_n']?.[d*DATA.taus.length+t]??8])),hovertemplate:'d=%{x}<br>τ=%{y:.5g}<br>value=%{z:.6g}<br>Monte Carlo SE=%{customdata[0]:.3g}<br>valid histories=%{customdata[1]}<extra></extra>'};
const all=DATA.contexts.flatMap(c=>c.metrics[k]).filter(v=>v!==null&&Number.isFinite(v));if(signed(k)){const limit=Math.max(1e-12,...all.map(Math.abs));trace.zmin=-limit;trace.zmax=limit;trace.zmid=0}else if(prob(k)){trace.zmin=0;trace.zmax=1}else if(all.length){trace.zmin=Math.min(...all);trace.zmax=Math.max(...all)}
Plotly.react('traitMap',[trace],layout({xaxis:{title:{text:'Juvenile deference d'},range:[0,1]},yaxis:{title:{text:'Maturation τ · log scale'},type:'log',tickvals:[.5,1,2,3,6,12],range:[Math.log10(.5),Math.log10(12)]}}),cfg).then(()=>{const g=$('traitMap');g.removeAllListeners('plotly_click');g.on('plotly_click',e=>{const p=e.points?.[0];if(!p)return;di=near(DATA.ds,p.x);ti=near(DATA.taus,p.y);cursor=0;refresh()})});
const values=ctx.metrics[k].filter(v=>v!==null&&Number.isFinite(v));if(!values.length){$('mapStatus').textContent='Unavailable in this context; missing values are not replaced by zero.';return}const top=Math.max(...values),tol=1e-9*Math.max(1,Math.abs(top)),ties=ctx.metrics[k].map((v,i)=>v!==null&&Math.abs(v-top)<=tol?i:-1).filter(i=>i>=0);let edge=ties.some(i=>Math.floor(i/DATA.taus.length)===0||Math.floor(i/DATA.taus.length)===DATA.ds.length-1||i%DATA.taus.length===0||i%DATA.taus.length===DATA.taus.length-1);$('mapStatus').textContent=`${values.length} valid cells. Maximum ${fmt(top)} across ${ties.length} tied cell(s); ${edge?'at least one maximum is a grid boundary.':'all grid maxima are interior.'} Maxima are outcome-specific grid summaries, not evolutionary stable strategies.`}
function regimes(){const traces=[0,.1,1].map(eta=>{const cs=DATA.contexts.filter(c=>c.eta_A===eta);return {type:'scatter',mode:'lines+markers',name:'Adult η='+eta,x:cs.map(c=>c.kappa),y:cs.map(c=>c.metrics.mean_N[idx()]),error_y:{type:'data',array:cs.map(c=>c.metrics.mean_N_se[idx()]),visible:true}}});Plotly.react('regimePlot',traces,layout({xaxis:{title:{text:'Environmental flip hazard κ · 1/time'}},yaxis:{title:{text:'Mean N · density'}}}),cfg)}
function cursorShape(){return [{type:'line',xref:'x',yref:'paper',x0:DATA.t[cursor],x1:DATA.t[cursor],y0:0,y1:1,line:{color:'#e9b365',width:2,dash:'dot'}}]}
function drawTime(id,keys,names,axis,perCap=false){const traces=[];for(let j=0;j<keys.length;j++){const k=keys[j];let y=k==='net'?series('B').map((v,i)=>v-series('D')[i]):series(k);if(perCap)y=y.map((v,i)=>series('N')[i]>0?v/series('N')[i]:null);traces.push({x:DATA.t,y,name:names[j],type:'scatter',mode:'lines'});if($('view').value==='mean'&&ctx.series[k]&&!perCap&&['N','belief_A'].includes(k)){const mean=ctx.series[k].mean[idx()],sd=ctx.series[k].sd[idx()];traces.push({x:DATA.t,y:mean.map((v,i)=>v+sd[i]),type:'scatter',mode:'lines',line:{width:0},showlegend:false,hoverinfo:'skip'},{x:DATA.t,y:mean.map((v,i)=>v-sd[i]),type:'scatter',mode:'lines',line:{width:0},fill:'tonexty',fillcolor:'#8fc9dc25',showlegend:false,hoverinfo:'skip'})}}
Plotly.react(id,traces,layout({xaxis:{title:{text:'Time · model units'}},yaxis:{title:{text:axis}},shapes:cursorShape()}),cfg)}
function plots(){drawTime('populationPlot',['F','A','N'],['Juveniles','Adults','Total'],'Population density');drawTime('fluxPlot',['B','D','M','net'],['Births B','Deaths D','Maturation M','B−D'],$ ('perCapita').checked?'Per-capita flux · 1/time':'Flux · density/time',$('perCapita').checked);drawTime('beliefPlot',['private_F','public_F','belief_A'],['Juvenile private','Juvenile public','Adult held belief'],'Correctness probability');if($('view').value==='sample'){Plotly.addTraces('beliefPlot',{x:DATA.t,y:DATA.t.map(t=>(truth(ctx,t)+1)/2),name:'Truth sign (+1 → 1)',type:'scatter',mode:'lines',line:{shape:'hv',dash:'dot',color:'#e9b365'}})}distribution()}
function distribution(){const norm=dist=>{const a=dist[idx()][cursor],sum=a.reduce((x,y)=>x+y,0);return a.map(v=>sum>0?v/sum:null)};Plotly.react('distributionPlot',[{x:DATA.scores,y:norm(ctx.distF),type:'bar',name:'Juvenile conviction'},{x:DATA.scores,y:norm(ctx.distA),type:'bar',name:'Adult conviction'}],layout({barmode:'group',xaxis:{title:{text:'Held conviction score b'}},yaxis:{title:{text:'Within-stage fraction'},range:[0,1]}}),cfg)}
function followupPlots(){const f=DATA.followups;Plotly.react('cohortPlot',f.cohort.map(c=>({type:'scatter',mode:'lines',x:c.t,y:c.adult_accuracy,name:'Adult η='+c.eta_A})),layout({xaxis:{title:{text:'Time after truth reversal'}},yaxis:{title:{text:'Adult accuracy'},range:[0,1]}}),cfg);const traces=[0,.5,1].map((d,i)=>{const ks=[0,.01,.2],means=[],errors=[];for(const k of ks){const rows=f.held_out.filter(r=>r.kappa===k).map(r=>r.mean_N[i]);const m=rows.reduce((a,b)=>a+b,0)/rows.length;means.push(m);errors.push(Math.sqrt(rows.reduce((s,v)=>s+(v-m)**2,0)/(rows.length-1)/rows.length))}return {type:'scatter',mode:'lines+markers',x:ks,y:means,name:'d='+d,error_y:{type:'data',array:errors,visible:true}}});Plotly.react('heldoutPlot',traces,layout({xaxis:{title:{text:'Environmental κ · 1/time'}},yaxis:{title:{text:'Held-out mean N · density'}}}),cfg)}
function snapshot(){const n=series('N')[cursor],f=series('F')[cursor],a=series('A')[cursor];$('fNow').textContent=fmt(f);$('aNow').textContent=fmt(a);$('nNow').textContent=fmt(n);$('bNow').textContent=fmt(series('B')[cursor]);$('deathNow').textContent=fmt(series('D')[cursor]);$('mNow').textContent='M = '+fmt(series('M')[cursor])+' density/time';$('thetaNow').textContent=$('view').value==='mean'?'ensemble':truth(ctx,DATA.t[cursor]);$('accNow').textContent=fmt(series('belief_A')[cursor]);$('fMeter').style.width=(n>0?100*f/n:0)+'%';$('aMeter').style.width=(n>0?100*a/n:0)+'%';$('timeOut').textContent=fmt(DATA.t[cursor]);$('scrub').value=cursor;AppState.cursor=cursor}
function scrub(){snapshot();for(const id of ['populationPlot','fluxPlot','beliefPlot','comparisonPlot'])if($(id).data)Plotly.relayout(id,{shapes:cursorShape()});distribution()}
function compare(){const traces=pins.map(p=>{const c=DATA.contexts.find(v=>v.id===p.ctx);const i=p.di*DATA.taus.length+p.ti;return {x:DATA.t,y:series('N',c,i),mode:'lines',name:`d=${DATA.ds[p.di]}, τ=${fmt(DATA.taus[p.ti])}, η=${c.eta_A}, κ=${c.kappa}`}});Plotly.react('comparisonPlot',traces,layout({xaxis:{title:{text:'Time · model units'}},yaxis:{title:{text:'N · independent density'}},shapes:cursorShape()}),cfg);$('pins').innerHTML=pins.length?'<table><thead><tr><th>d</th><th>τ</th><th>η adult</th><th>κ</th><th>Mean N</th><th>Adult accuracy</th><th>Relative invasion</th></tr></thead><tbody>'+pins.map(p=>{const c=DATA.contexts.find(v=>v.id===p.ctx),i=p.di*DATA.taus.length+p.ti;return '<tr>'+[DATA.ds[p.di],DATA.taus[p.ti],c.eta_A,c.kappa,c.metrics.mean_N[i],c.metrics.adult_accuracy[i],c.metrics.invasion_relative[i]].map(v=>'<td>'+fmt(v)+'</td>').join('')+'</tr>'}).join('')+'</tbody></table>':'No pinned populations.'}
function matched(){pins=[0,near(DATA.ds,.5),DATA.ds.length-1].map(i=>({ctx:ctx.id,di:i,ti}));compare()}
function refresh(){refreshControls();heatmap();regimes();plots();snapshot();compare()}
function download(name,content,type){if(window.__captureDownload){window.__captureDownload(name,content);return}const url=URL.createObjectURL(new Blob([content],{type})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),5000)}
function csv(rows){return rows.map(row=>row.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(',')).join('\n')}
function stop(){if(timer)clearInterval(timer);timer=null;AppState.playing=false}
async function boot(){DATA=await embeddedData();window.V6Data=DATA;for(const [k,[name]] of Object.entries(METRICS))$('metric').add(new Option(name,k));$('dSlider').max=DATA.ds.length-1;$('tauSlider').max=DATA.taus.length-1;$('scrub').max=DATA.t.length-1;ti=near(DATA.taus,3);$('metric').value='mean_N';ctx=current();matched();$('app').hidden=false;$('loadStatus').hidden=true;
for(const id of ['plasticity','kappa','metric','view'])$(id).onchange=()=>{stop();cursor=0;refresh()};$('dSlider').oninput=()=>{di=Number($('dSlider').value);refresh()};$('tauSlider').oninput=()=>{ti=Number($('tauSlider').value);refresh()};$('scrub').oninput=()=>{stop();cursor=Number($('scrub').value);scrub()};$('perCapita').onchange=plots;$('pin').onclick=()=>{if(pins.length>=8)pins.shift();pins.push({ctx:ctx.id,di,ti});compare()};$('matched').onclick=matched;$('clearPins').onclick=()=>{pins=[];compare()};$('pause').onclick=stop;$('resetTime').onclick=()=>{stop();cursor=0;scrub()};$('play').onclick=()=>{stop();AppState.playing=true;timer=setInterval(()=>{cursor=Math.min(DATA.t.length-1,cursor+Number($('speed').value));scrub();if(cursor===DATA.t.length-1)stop()},250)};$('resetConfig').onclick=()=>{stop();$('plasticity').value='.1';$('plasticity').value='0.1';$('kappa').value='0.05';$('metric').value='mean_N';$('view').value='sample';di=near(DATA.ds,.5);ti=near(DATA.taus,3);cursor=0;ctx=current();matched();refresh()};
$('exportConfig').onclick=()=>download('v6-configuration.json',JSON.stringify(selected(),null,2),'application/json');$('exportSweep').onclick=()=>{const keys=Object.keys(METRICS),rows=[['label','run_id','context','eta_A','kappa','d','tau',...keys.flatMap(k=>[k,k+'_se'])]];DATA.ds.forEach((d,i)=>DATA.taus.forEach((tau,j)=>{const index=i*DATA.taus.length+j;rows.push(['simulation data',DATA.run_id,ctx.id,ctx.eta_A,ctx.kappa,d,tau,...keys.flatMap(k=>[ctx.metrics[k][index],ctx.metrics[k+'_se']?.[index]])])}));download('v6-sweep.csv',csv(rows),'text/csv')};$('exportSeries').onclick=()=>{const keys=Object.keys(ctx.series),rows=[['label','run_id','context','d','tau','time','sample_theta',...keys.flatMap(k=>[k+'_sample',k+'_mean',k+'_sd'])]];DATA.t.forEach((t,j)=>rows.push(['simulation data',DATA.run_id,ctx.id,DATA.ds[di],DATA.taus[ti],t,truth(ctx,t),...keys.flatMap(k=>['sample','mean','sd'].map(v=>ctx.series[k][v][idx()][j]))]));download('v6-timeseries.csv',csv(rows),'text/csv')};refresh();followupPlots()}
boot().catch(e=>{$('loadStatus').textContent='Cannot load simulation data: '+e.message;console.error(e)});
</script>
<!-- STANDALONE_DOWNLOADS_START -->
<script>window.PUBLICATION_PACKAGES=["adult0p0_k0p0", "adult0p0_k0p01", "adult0p0_k0p05", "adult0p0_k0p2", "adult0p1_k0p0", "adult0p1_k0p01", "adult0p1_k0p05", "adult0p1_k0p2", "adult1p0_k0p0", "adult1p0_k0p01", "adult1p0_k0p05", "adult1p0_k0p2", "all", "followups"];window.PUBLICATION_REFERENCE_BASE='./experiments/';window.PUBLICATION_REFERENCE_SUFFIX='.npz';window.PUBLICATION_PACKAGE_INDEX='./README.md';window.PUBLICATION_REFERENCE_URLS={all:'./experiments/sweep.csv',followups:'./experiments/followups.json'};</script>
<script>/* Exact displayed traces and reference experiment archives. */
(()=>{'use strict';const version=document.documentElement.dataset.publicationVersion;
const family=id=>version==='v6'&&/cohort|heldout/i.test(id)?'followups':version==='v6'&&/regime|comparison/i.test(id)?'all':/volatility/i.test(id)?'volatility':/bayes/i.test(id)?'bayes_benchmark':/tutor/i.test(id)?'repertoire_tutors':/repertoire/i.test(id)?'repertoire':/source/i.test(id)?'source_conditions':/mechanism/i.test(id)?'mechanisms':/histor/i.test(id)?'histories':/replacement/i.test(id)?'frozen_replacement':/selection|frequency|meanTrait|pairwise|architecture|competition|reproductive/i.test(id)?'evolution':null;
const encoder=new TextEncoder(),crcTable=Array.from({length:256},(_,n)=>{for(let k=0;k<8;k++)n=n&1?0xedb88320^(n>>>1):n>>>1;return n>>>0});
function crc32(bytes){let c=0xffffffff;for(const b of bytes)c=crcTable[(c^b)&255]^(c>>>8);return (c^0xffffffff)>>>0}
function zip(files){let offset=0;const local=[],central=[];for(const [name,content] of Object.entries(files)){const n=encoder.encode(name),b=encoder.encode(content),crc=crc32(b),h=new Uint8Array(30+n.length),v=new DataView(h.buffer);v.setUint32(0,0x04034b50,true);v.setUint16(4,20,true);v.setUint32(14,crc,true);v.setUint32(18,b.length,true);v.setUint32(22,b.length,true);v.setUint16(26,n.length,true);h.set(n,30);local.push(h,b);const c=new Uint8Array(46+n.length),w=new DataView(c.buffer);w.setUint32(0,0x02014b50,true);w.setUint16(4,20,true);w.setUint16(6,20,true);w.setUint32(16,crc,true);w.setUint32(20,b.length,true);w.setUint32(24,b.length,true);w.setUint16(28,n.length,true);w.setUint32(42,offset,true);c.set(n,46);central.push(c);offset+=h.length+b.length}const end=new Uint8Array(22),v=new DataView(end.buffer),size=central.reduce((n,b)=>n+b.length,0);v.setUint32(0,0x06054b50,true);v.setUint16(8,central.length,true);v.setUint16(10,central.length,true);v.setUint32(12,size,true);v.setUint32(16,offset,true);return new Blob([...local,...central,end],{type:'application/zip'})}
const stringify=x=>JSON.stringify(x,(_,v)=>ArrayBuffer.isView(v)?Array.from(v):v,2);
function exportPlot(graph){let configuration=document.getElementById('configView')?.textContent||document.getElementById('config')?.textContent||'';try{configuration=JSON.parse(configuration)}catch{}if(!configuration&&typeof p!=='undefined')configuration=JSON.parse(JSON.stringify(p));
const meta={label:'simulation data',version,figure:graph.id,exported_utc:new Date().toISOString(),run_id:document.getElementById('runId')?.textContent||document.querySelector('header')?.textContent,selection:window.AppState?Object.fromEntries(['context','ctx','di','ti','cursor'].filter(k=>k in window.AppState).map(k=>[k,typeof window.AppState[k]==='object'?window.AppState[k]?.id:window.AppState[k]])):null,configuration,axes:{x:graph.layout?.xaxis?.title,y:graph.layout?.yaxis?.title,y2:graph.layout?.yaxis2?.title},note:'Actual currently displayed traces, including custom browser calculations; reference experiment archives are separate.'};
const rows=['trace,name,x,y,z'];const cell=v=>'"'+String(v??'').replaceAll('"','""')+'"';(graph.data||[]).forEach((t,k)=>{if(Array.isArray(t.z)&&Array.isArray(t.z[0]))t.z.forEach((row,i)=>row.forEach((z,j)=>rows.push([k,t.name,t.x?.[j]??j,t.y?.[i]??i,z].map(cell).join(','))));else {const n=Math.max(t.x?.length||0,t.y?.length||0);for(let i=0;i<n;i++)rows.push([k,t.name,t.x?.[i],t.y?.[i],t.z?.[i]].map(cell).join(','))}});
const files={'plot.json':stringify({data:graph.data,layout:graph.layout}),'parameters.json':stringify(meta),'raw-records.csv':rows.join('\n'),'README.txt':'Simulation data from the exact displayed Plotly traces. plot.json retains full trace structure; raw-records.csv flattens x/y/z values. parameters.json records available units, selection, configuration and provenance. The reference archive below each plot supplies saved experiment data and source definitions.\n'},blob=zip(files),name=version+'-'+(graph.id||'plot')+'-data.zip';if(window.__capturePlotZip){window.__capturePlotZip(name,blob,files);return}const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),10000)}
function reference(id){const packages=window.PUBLICATION_PACKAGES||[],f=family(id),ctx=window.AppState?.ctx||window.AppState?.context;return packages.includes(f)?f:packages.includes(ctx)?ctx:'all'}
function scan(){document.querySelectorAll('.js-plotly-plot').forEach(g=>{let bar=document.getElementById('download-'+g.id);if(!bar){bar=document.createElement('div');bar.id='download-'+g.id;bar.className='publication-download';const button=document.createElement('button');button.textContent='Download this plot’s raw data ZIP';button.onclick=()=>exportPlot(g);const a=document.createElement('a');a.textContent='Reference experiment package';a.className='reference-package';a.setAttribute('download','');const all=document.createElement('a');all.href=window.PUBLICATION_PACKAGE_INDEX||'../downloads/'+version+'/index.html';all.textContent='All datasets for '+version.toUpperCase();all.target='_blank';bar.append(button,a,all);g.after(bar)}bar.querySelector('.reference-package').href=window.PUBLICATION_REFERENCE_URLS?.[reference(g.id)]||(window.PUBLICATION_REFERENCE_BASE||'../downloads/'+version+'/')+reference(g.id)+(window.PUBLICATION_REFERENCE_SUFFIX||'.zip')})}
let pending=false;new MutationObserver(()=>{if(!pending){pending=true;setTimeout(()=>{pending=false;scan()},150)}}).observe(document.body,{childList:true,subtree:true});setInterval(scan,2000);scan();window.exportPublicationPlot=exportPlot;
})();
</script>
<!-- STANDALONE_DOWNLOADS_END -->
</body></html>
