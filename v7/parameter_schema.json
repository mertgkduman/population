{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V7 frozen execution configuration",
  "type": "object",
  "required": ["schema_version", "model", "task_economics", "information", "budgets", "development", "founders", "demography", "bounds", "discovery", "holdout", "precision"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v7-1.0"},
    "model": {"type": "object", "additionalProperties": false, "required": ["kind", "families", "depths"], "properties": {"kind": {"const": "discrete_event_overlapping_generation_ibm"}, "families": {"const": 2}, "depths": {"const": [1, 3, 6]}}},
    "task_economics": {"type": "object", "additionalProperties": false, "required": ["p_plus", "p_minus", "h_safe", "c_step", "incorrect_finish_loss", "salvage", "correct_finish_reward"], "properties": {"p_plus": {"const": 0.9}, "p_minus": {"const": 0.5}, "h_safe": {"const": 1.2}, "c_step": {"const": 0.2}, "incorrect_finish_loss": {"const": 2}, "salvage": {"const": 0.2}, "correct_finish_reward": {"const": {"1": 3.6, "3": 9.1, "6": 22.1}}}},
    "information": {"type": "object", "additionalProperties": false, "required": ["rho", "chi", "q_theta"], "properties": {"rho": {"const": 0.8}, "chi": {"const": [0.5, 0.75, 1.0]}, "q_theta": {"const": [0.0, 0.005, 0.02]}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["time_tokens", "computation_operations", "q0_horizon", "delta"], "properties": {"time_tokens": {"const": 12}, "computation_operations": {"const": 128}, "q0_horizon": {"const": 2}, "delta": {"const": 0.97}}},
    "development": {"type": "object", "additionalProperties": false, "required": ["primary_override", "tau", "adult_override_in_persistence"], "properties": {"primary_override": {"const": "juvenile_window"}, "tau": {"const": 5}, "adult_override_in_persistence": {"const": 0.0}}},
    "founders": {"type": "object", "additionalProperties": false, "required": ["count", "initial_acquired_state", "burn_in_seasons", "teaching_independent_successes"], "properties": {"count": {"const": 64}, "initial_acquired_state": {"const": "empty_B_K_T_H"}, "burn_in_seasons": {"const": 60}, "teaching_independent_successes": {"const": 2}}},
    "demography": {"type": "object", "additionalProperties": false, "required": ["resource_capacity", "regeneration", "conversion_efficiency", "maintenance", "birth_cost", "newborn_energy", "reserve", "birth_max"], "properties": {"resource_capacity": {"const": 1600}, "regeneration": {"const": 0.08}, "conversion_efficiency": {"const": 0.75}, "maintenance": {"const": 0.6}, "birth_cost": {"const": 16}, "newborn_energy": {"const": 8}, "reserve": {"const": 3}, "birth_max": {"const": 0.5}}},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["measurement_seasons", "shock_measurement_season", "lineage_seasons", "competition_seasons", "persistence_training", "persistence_per_intervention", "population_cap", "event_cap", "trajectory_seconds", "workers", "wall_hours", "trajectory_cap", "decision_records", "representative_histories"], "properties": {"measurement_seasons": {"const": 180}, "shock_measurement_season": {"const": 90}, "lineage_seasons": {"const": 80}, "competition_seasons": {"const": 120}, "persistence_training": {"const": 40}, "persistence_per_intervention": {"const": 20}, "population_cap": {"const": 512}, "event_cap": {"const": 1500000}, "trajectory_seconds": {"const": 120}, "workers": {"const": 4}, "wall_hours": {"const": 12}, "trajectory_cap": {"const": 12000}, "decision_records": {"const": 10000}, "representative_histories": {"const": 24}}},
    "discovery": {"type": "object", "additionalProperties": false, "required": ["seeds", "policy_count", "policies", "l9_rows", "verification_production_cost", "screening_interactions"], "properties": {"seeds": {"const": [71001, 71002, 71003, 71004]}, "policy_count": {"const": 14}, "policies": {"const": ["vector_0_0", "vector_0_0_5", "vector_0_1", "vector_0_5_0", "vector_0_5_0_5", "vector_0_5_1", "vector_1_0", "vector_1_0_5", "vector_1_1", "scalar_0_25", "scalar_0_75", "asocial_access_off", "feature_trust", "candidate_b_resource_rational"]}, "l9_rows": {"const": [[1,1,1,1],[1,2,2,2],[1,3,3,3],[2,1,2,3],[2,2,3,1],[2,3,1,2],[3,1,3,2],[3,2,1,3],[3,3,2,1]]}, "verification_production_cost": {"const": [0.1, 0.5, 1.5]}, "screening_interactions": {"const": "aliased"}}},
    "holdout": {"type": "object", "additionalProperties": false, "required": ["seeds", "batch", "maximum"], "properties": {"seeds": {"const": [72001,72002,72003,72004,72005,72006,72007,72008,72009,72010,72011,72012,72013,72014,72015,72016,72017,72018,72019,72020,72021,72022,72023,72024]}, "batch": {"const": 8}, "maximum": {"const": 96}}},
    "precision": {"type": "object", "additionalProperties": false, "required": ["net_energy_mcse", "proportion_half_width", "useful_depth_mcse", "recovery_mcse", "population_mcse", "descendants_mcse"], "properties": {"net_energy_mcse": {"const": 0.1}, "proportion_half_width": {"const": 0.1}, "useful_depth_mcse": {"const": 0.25}, "recovery_mcse": {"const": 2}, "population_mcse": {"const": 5}, "descendants_mcse": {"const": 0.25}}}
  }
}
